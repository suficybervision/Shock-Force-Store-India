# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated Google account emails authorized for the Admin Dashboard.
ADMIN_EMAILS=""

# ORDER_TOKEN_SECRET: Server-side HMAC secret for customer order status lookup tokens.
ORDER_TOKEN_SECRET=""
